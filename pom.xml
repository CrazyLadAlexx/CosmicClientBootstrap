<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>me.alex</groupId>
    <artifactId>CosmicClientBootstrap</artifactId>
    <version>1.0.0</version>
    <name>CosmicClientBootstrap</name>
    <description>Standalone Cosmic client packet bootstrap for Spigot 1.8.8.</description>
    <url>https://github.com/CrazyLadAlexx/CosmicClientBootstrap</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit/</url>
        </license>
    </licenses>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>
    <dependencies>
        <dependency>
            <groupId>me.alex.cosmicclientbootstrap.vendor</groupId>
            <artifactId>twspigot</artifactId>
            <version>local</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.alex.cosmicclientbootstrap.vendor</groupId>
            <artifactId>CosmicClientAPI</artifactId>
            <version>local</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.alex.cosmicclientbootstrap.vendor</groupId>
            <artifactId>DemonicClientComms</artifactId>
            <version>local</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.alex.cosmicclientbootstrap.vendor</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>local</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>
</project>
